{
  "name": "labeler",
  "version": "1.0.0-dev",
  "private": true,
  "description": "Web interface for Brother P-Touch label printers through ptouch-print",
  "license": "MIT",
  "author": "Philipp Mundhenk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PhilippMundhenk/labeler.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint . && node tools/check-versions.js",
    "test": "npm run lint && npm run test:unit && npm run test:e2e && npm run coverage",
    "test:unit": "c8 --check-coverage=false --reporter=text-summary node --test \"tests/js/**/*.test.js\"",
    "test:e2e": "playwright test",
    "coverage": "c8 report --temp-directory coverage/v8 --reports-dir coverage/js",
    "screenshots": "node tools/screenshots.js",
    "demo": "sh tools/demo.sh"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@zxing/library": "^0.23.0",
    "c8": "^12.0.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0"
  }
}
