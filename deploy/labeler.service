# Labeler with PHP's built-in web server, no Apache/nginx needed.
# Install: see docs/INSTALL.md. Assumes the release is unpacked to /opt/labeler.
[Unit]
Description=Labeler, web interface for P-Touch label printers
After=network-online.target
Wants=network-online.target

[Service]
User=labeler
Group=labeler
# access to the printer (udev rule deploy/99-labeler-ptouch.rules)
SupplementaryGroups=lp
WorkingDirectory=/opt/labeler
ExecStart=/usr/bin/php -S 0.0.0.0:8080 -t /opt/labeler/public /opt/labeler/src/router.php
Environment=LABELER_DATA_DIR=/var/lib/labeler
# several requests at once: a print or a wrong password must not block everyone else
Environment=PHP_CLI_SERVER_WORKERS=3
StateDirectory=labeler
Restart=on-failure
RestartSec=5

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
